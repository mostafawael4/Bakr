PORT=3000
NODE_ENV=development
MONGO_URI=              # MongoDB Atlas connection string
SESSION_SECRET=         # Any long random string
FRONTEND_URL=http://localhost:4200

# Backblaze B2 — fill before deploying
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_ID=
B2_BUCKET_NAME=
B2_ENDPOINT=            # e.g. https://s3.us-east-005.backblazeb2.com
B2_REGION=              # e.g. us-east-005
B2_PRIVATE=false        # Set to 'true' ONLY if bucket is private (requires presigned URLs)

# CDN — OPTIONAL. Only set these if you put a CDN (e.g. Cloudflare) in front of B2.
# When empty, public URLs are auto-derived from B2_ENDPOINT + B2_BUCKET_NAME.
CDN_URL=
OFFICIAL_CDN_URL=

UPLOAD_DIR=uploads/
TEMP_DIR=tmp/
